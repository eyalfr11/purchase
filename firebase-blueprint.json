{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "Inventory and purchase recommendation item",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 64, "description": "SKU / Item code" },
        "desc": { "type": "string", "maxLength": 255, "description": "Item description" },
        "cat": { "type": "string", "maxLength": 100, "description": "Item category" },
        "series": { "type": "string", "maxLength": 100, "description": "Item series or family" },
        "stock": { "type": "number", "description": "Current on-hand inventory" },
        "cust_ord": { "type": "number", "description": "Customer allocated orders" },
        "res_ord": { "type": "number", "description": "Reserved orders" },
        "po_imp": { "type": "number", "description": "Purchase orders in import" },
        "ship_imp": { "type": "number", "description": "Import shipments on the way" },
        "lead_time": { "type": "number", "description": "Lead time in days" },
        "avg3": { "type": "number", "description": "Average 3-month consumption" },
        "avg6": { "type": "number", "description": "Average 6-month consumption" },
        "avg12": { "type": "number", "description": "Average 12-month consumption" },
        "erp_rec": { "type": "number", "description": "ERP recommended purchase quantity" },
        "has_erp_rec": { "type": "boolean", "description": "Whether ERP had a hardcoded recommendation" },
        "notes": { "type": "string", "maxLength": 500, "description": "Optional manager notes" },
        "updatedAt": { "type": "string", "description": "Timestamp string of last update" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "UID or email of last editor" }
      },
      "required": ["code", "desc", "stock", "lead_time", "avg6"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and role metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255, "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 128, "description": "User display name" },
        "role": { "type": "string", "enum": ["admin", "manager", "viewer"], "description": "User assigned role" },
        "createdAt": { "type": "string", "description": "User registration timestamp" },
        "updatedAt": { "type": "string", "description": "User profile update timestamp" }
      },
      "required": ["email", "role"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Marker document designating system administrator status",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255, "description": "Admin email" },
        "grantedAt": { "type": "string", "description": "Timestamp when admin access was granted" }
      },
      "required": ["email"]
    },
    "ManagerRecord": {
      "title": "ManagerRecord",
      "description": "Marker document designating manager status",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255, "description": "Manager email" },
        "grantedAt": { "type": "string", "description": "Timestamp when manager access was granted" }
      },
      "required": ["email"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail log of item edits and imports",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 64, "description": "Action performed (e.g. edit_item, import_csv)" },
        "itemCode": { "type": "string", "maxLength": 64, "description": "Item SKU if applicable" },
        "details": { "type": "string", "maxLength": 500, "description": "Details of the change" },
        "userId": { "type": "string", "maxLength": 128, "description": "UID of performer" },
        "userEmail": { "type": "string", "maxLength": 255, "description": "Email of performer" },
        "timestamp": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["action", "userId", "timestamp"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Catalog items and stock metrics"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles and roles"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Secure role verification documents for administrators"
    },
    "/managers/{userId}": {
      "schema": { "$ref": "#/entities/ManagerRecord" },
      "description": "Secure role verification documents for managers"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit trail log for tracking purchase and inventory changes"
    }
  }
}
